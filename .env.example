# Copy to .env and fill in. Never commit .env.

# MiniStack endpoint. Unset = real AWS via boto3's default credential chain.
MINISTACK_ENDPOINT_URL=http://localhost:4566

# MiniStack ignores signatures, but boto3 and the aws CLI need some values.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# OpenAI-compatible model endpoint (OpenRouter by default).
EVAL_BASE_URL=https://openrouter.ai/api/v1
EVAL_API_KEY=
EVAL_MODEL=
